ATLAS_AI_PROVIDER=VERCEL_AI_GATEWAY
ATLAS_AI_MODEL=
# Optional outside Vercel; VERCEL_OIDC_TOKEN is supplied automatically on linked deployments.
AI_GATEWAY_API_KEY=
LYRA_VOICE_PROVIDER=
LYRA_VOICE_API_KEY=
LYRA_VOICE_ID=
LYRA_VOICE_MODEL=
COMMANDER_AUTH_KEY=
COMMANDER_SESSION_SECRET=
ATLAS_PUBLIC_URL=http://localhost:5173
# Exactly 32 random bytes encoded as base64, or 64 hexadecimal characters.
ATLAS_TOKEN_ENCRYPTION_KEY=
# Optional rotation fallback. Remove after all stored records have been re-encrypted with the active key.
ATLAS_TOKEN_ENCRYPTION_KEY_ID=primary
ATLAS_TOKEN_ENCRYPTION_KEY_PREVIOUS=
ATLAS_TOKEN_ENCRYPTION_KEY_PREVIOUS_ID=previous
# Optional on local development; required on Vercel for OAuth state and token storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel supplies VERCEL_OIDC_TOKEN automatically for AI Gateway deployments.
# Neon Postgres connection string for missions, TAIN, approvals, conversations, sync history, and audit events.
DATABASE_URL=
# Optional webhook framework secret; define provider-specific secrets instead when a provider requires them.
ATLAS_WEBHOOK_SIGNING_SECRET=

# Optional server-only account-linking applications. Never prefix these with VITE_.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Set only when the selected Discord application configuration officially supports PKCE.
DISCORD_OAUTH_PKCE_ENABLED=0
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
META_FACEBOOK_LOGIN_ENABLED=0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_INSTAGRAM_LOGIN_ENABLED=0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional provider-neutral cloud adapters. Never expose these to Vite/client code.
ATLAS_CLOUD_PROVIDER=VERCEL_SERVERLESS
REDIS_URL=
OBJECT_STORAGE_URL=
OBJECT_STORAGE_TOKEN=
QUEUE_URL=
QUEUE_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
